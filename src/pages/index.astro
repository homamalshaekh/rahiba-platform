---
import Layout from '../layouts/Layout.astro';
import DutyPharmacies from '../components/DutyPharmacies.astro';
import { svg } from '../lib/icons';

const cats = [
  { href: '/doctors',    label: 'الأطباء',          icon: 'stethoscope', box: 'border-mint-line bg-white text-brand',       dot: 'bg-emerald-100' },
  { href: '/nurses',     label: 'الممرضون',         icon: 'heart-pulse', box: 'border-mint-line bg-white text-brand',       dot: 'bg-emerald-100' },
  { href: '/physio',     label: 'العلاج الفيزيائي', icon: 'activity',    box: 'border-azure-line bg-azure-soft text-azure', dot: 'bg-sky-100' },
  { href: '/centers',    label: 'المراكز الطبية',   icon: 'building',    box: 'border-azure-line bg-azure-soft text-azure', dot: 'bg-sky-100' },
  { href: '/pharmacies', label: 'الصيدليات',        icon: 'pill',        box: 'border-mint-line bg-white text-brand',       dot: 'bg-emerald-100' },
  { href: '/emergency',  label: 'الطوارئ والإسعاف', icon: 'ambulance',   box: 'border-alert-line bg-alert-soft text-alert', dot: 'bg-red-100' },
];
---
<Layout>
  <!-- الهيرو -->
  <section class="relative overflow-hidden min-h-[320px] bg-linear-to-br from-white via-mint to-[#d9f1e4]">
    <div class="hidden md:block absolute inset-y-0 end-0 w-[46%] bg-cover bg-center"
         style="background-image:url('/hero-doctor.jpg');-webkit-mask-image:linear-gradient(to right,#000 60%,transparent);mask-image:linear-gradient(to right,#000 60%,transparent)"></div>

    <svg viewBox="0 0 700 140" class="absolute bottom-0 start-0 w-full md:w-[62%] h-auto" aria-hidden="true">
      <path d="M0 140V95C90 60 170 110 270 85S430 30 520 62 640 70 700 40V140Z" fill="#cdeedd" />
      <path d="M0 140V112C110 82 200 125 300 105S460 62 560 88 660 92 700 70V140Z" fill="#a9dcc2" />
      <g fill="#8fcfb0">
        <rect x="612" y="58" width="22" height="56" /><rect x="640" y="40" width="30" height="76" /><rect x="676" y="64" width="20" height="50" />
      </g>
      <path d="M430 20c-14 0-24 10-24 23 0 17 24 38 24 38s24-21 24-38c0-13-10-23-24-23z" fill="#1aa56f" />
      <path d="M418 42h7l3-6 5 12 3-6h6" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M110 112c0-14 8-22 20-24-1 14-8 22-20 24z" fill="#34b27c" /><path d="M110 112c0-10-6-17-16-18 1 11 7 17 16 18z" fill="#34b27c" />
    </svg>

    <div class="relative max-w-6xl mx-auto px-4 pt-10 pb-24 md:pt-14">
      <div class="max-w-xl">
        <h1 class="text-4xl md:text-5xl font-black leading-tight">دليل الرحيبة الطبي</h1>
        <p class="mt-3 text-lg leading-8 text-ink/80">
          تعرّف على الأطباء والمراكز والصيدليات والنقاط الطبية في مدينة الرحيبة، وابحث بسرعة عن جهات الطوارئ والإسعاف.
        </p>
        <p class="mt-5 font-script text-2xl text-brand">معًا .. لمدينة أكثر صحة</p>
        <svg viewBox="0 0 200 12" class="w-48 text-brand" aria-hidden="true">
          <path d="M2 8C50 2 120 2 198 6" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" />
        </svg>
      </div>
    </div>
  </section>

  <!-- الأقسام -->
  <section class="max-w-6xl mx-auto px-4 pt-6">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
      {cats.map(c => (
        <a href={c.href} class={`flex flex-col gap-3 rounded-xl border p-4 ${c.box}`}>
          <span class={`grid place-items-center size-12 rounded-full ${c.dot}`}><Fragment set:html={svg(c.icon, 26)} /></span>
          <span class="flex items-center justify-between font-black text-lg">
            {c.label}
            <Fragment set:html={svg('chevron-left', 20)} />
          </span>
        </a>
      ))}
    </div>
  </section>

  <DutyPharmacies />

  <!-- البحث -->
  <section class="max-w-6xl mx-auto px-4 pt-6">
    <form action="/search" method="get" class="rounded-2xl border border-mint-line bg-mint/60 p-4 md:p-5">
      <h2 class="flex items-center gap-2 text-xl md:text-2xl font-black">
        <Fragment set:html={svg('search', 22, 'text-brand')} /> ابحث عن خدمة طبية
      </h2>
      <div class="mt-4 flex gap-3">
        <div class="relative grow">
          <button class="absolute inset-y-0 start-3 grid place-items-center text-brand" aria-label="بحث">
            <Fragment set:html={svg('search', 20)} />
          </button>
          <input name="q" type="search" class="field ps-11 rounded-full" placeholder="ابحث باسم الطبيب أو الاختصاص أو الصفة..." />
        </div>
        <button type="reset" class="shrink-0 inline-flex items-center gap-2 rounded-full bg-brand text-white font-semibold px-6">
          <Fragment set:html={svg('refresh', 18)} /> تحديث
        </button>
      </div>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        <label class="grid gap-1"><span class="text-sm font-bold">التخصص</span>
          <select name="sp" id="sp" class="field"><option value="">كل التخصصات</option></select></label>
        <label class="grid gap-1"><span class="text-sm font-bold">المنطقة أو العنوان</span>
          <select name="area" id="area" class="field"><option value="">كل المناطق</option></select></label>
        <label class="grid gap-1"><span class="text-sm font-bold">الخدمات</span>
          <select name="disc" class="field"><option value="">كل الخدمات</option><option value="1">تقدّم خصمًا</option></select></label>
      </div>
      <p class="mt-3 flex items-center gap-2 text-sm text-muted">
        <Fragment set:html={svg('pin', 16, 'text-brand')} />
        <span>للبحث عن الأقرب إليك يمكنك استخدام <a class="underline text-brand" target="_blank" rel="noopener" href="https://www.google.com/maps/search/صيدلية+الرحيبة">خرائط جوجل</a>.</span>
      </p>
    </form>
  </section>

  <!-- أطباء مميزون -->
  <section id="featSection" class="hidden max-w-6xl mx-auto px-4 pt-8">
    <div class="flex items-center justify-between">
      <h2 class="flex items-center gap-2 text-xl md:text-2xl font-black">
        <Fragment set:html={svg('user', 22, 'text-brand')} /> أطباء مميزون
      </h2>
      <a href="/doctors" class="inline-flex items-center gap-2 font-semibold text-brand">
        عرض الكل <Fragment set:html={svg('arrow-left', 18)} />
      </a>
    </div>
    <div id="featList" class="mt-4 grid gap-3 md:grid-cols-3"></div>
  </section>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { featuredCard, esc } from '../lib/card';

  async function init() {
    const feat = await supabase.from('providers').select('*')
      .eq('status', 'published').eq('type', 'doctor').eq('featured', true).limit(6);
    const rows = feat.data ?? [];
    document.getElementById('featList')!.innerHTML = rows.map((p, i) => featuredCard(p, i)).join('');
    document.getElementById('featSection')!.classList.toggle('hidden', rows.length === 0);

    const all = await supabase.from('providers').select('specialty, area').eq('status', 'published');
    const uniq = (k: string) => [...new Set((all.data ?? []).map((r: any) => r[k]).filter(Boolean))];
    const fill = (id: string, list: any[]) => {
      document.getElementById(id)!.innerHTML += list.map(v => `<option>${esc(v)}</option>`).join('');
    };
    fill('sp', uniq('specialty'));
    fill('area', uniq('area'));
  }
  init();
</script>